{
  "name": "celyah-robot-app",
  "version": "1.0.0",
  "private": true,
  "description": "Celyah Robot - Android app (Capacitor) to control the Celyah ESP32-S3 robot",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/copy-vendor.js",
    "dev": "node scripts/copy-vendor.js && vite",
    "build": "node scripts/copy-vendor.js && vite build",
    "android:add": "npx cap add android && node scripts/patch-android.js",
    "android:sync": "npm run build && npx cap sync android && node scripts/patch-android.js",
    "android:open": "npx cap open android",
    "assets": "npx capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor-community/bluetooth-le": ">=7.0.0",
    "@capacitor-community/speech-recognition": ">=7.0.0",
    "@capacitor-community/text-to-speech": ">=6.0.0",
    "mqtt": "^5.10.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}